{
  "name": "speechbot-studio",
  "version": "2.1.0",
  "private": true,
  "description": "A dependency-free text-to-speech and dictation studio with local scripts.",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "build": "node scripts/build-static.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test"
  },
  "engines": { "node": ">=20" }
}
